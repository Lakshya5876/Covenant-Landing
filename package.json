{
  "name": "covenant-landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck:functions": "tsc -p functions/tsconfig.json",
    "db:migrate:local": "wrangler d1 migrations apply covenant-board --local",
    "dev:full": "npm run build && npm run db:migrate:local && wrangler pages dev ./dist"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260815.1",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0"
  }
}
